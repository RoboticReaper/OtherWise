{
  "name": "otherwise-extension",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test extension/tests/*.test.js",
    "test:quick": "npm test && python3 -m pytest -q -m \"not layout_integration\"",
    "test:full": "npm test && python3 -m pytest -q",
    "build": "python3 scripts/build_extension.py",
    "test:browser": "node scripts/test_extension_browser.mjs",
    "test:ui": "node scripts/test_ui_browser.mjs",
    "test:galaxy": "node scripts/test_galaxy_browser.mjs",
    "test:discovery": "node scripts/test_discovery_browser.mjs",
    "test:local": "node scripts/test_local_connection_browser.mjs",
    "test:backup": "node scripts/test_backup_browser.mjs"
  }
}
